# 后端（AB_ 前缀的环境变量会被 Settings 读取；复制为 .env 后修改）
AB_DATA_DIR=data

# LLM：任意 OpenAI 兼容端点（本机网关 / vLLM / one-api / Ollama）
AB_LLM_BASE_URL=http://127.0.0.1:8009/v1
AB_LLM_API_KEY=sk-local
AB_LLM_MODEL=deepseek-flash
AB_LLM_TEMPERATURE=0.6
AB_LLM_CONCURRENCY=8
AB_LLM_TIMEOUT_SECONDS=120
AB_LLM_MAX_ATTEMPTS=2
AB_LLM_JSON_MODE=true

# 分析分块上限（字符数）
AB_LLM_CHUNK_CHARS=8000
AB_LLM_SCENE_WINDOW_CHARS=8000

# 产物导出（M3）
# ffmpeg 项目自带（imageio-ffmpeg 依赖，uv sync 时装好）；这里留空即可。
# 只有想用自己那份构建时才填：AB_FFMPEG_PATH=D:\tools\ffmpeg\bin\ffmpeg.exe
AB_FFMPEG_PATH=
AB_FFMPEG_TIMEOUT_SECONDS=1800
# 0 = 自动取各片段最高采样率；也可写死 22050 / 24000 / 48000
AB_EXPORT_TARGET_SAMPLE_RATE=0
# 章节封装容器：mkv（音频不重编码，最快）| mp4（AAC + mov_text，iPhone/剪映友好）
AB_EXPORT_CONTAINER=mkv
# 章节是否封装容器；false = 只出 wav/srt
AB_EXPORT_MKV=true
# 停顿（毫秒）：整体缩放 / 下限 / 上限 / 场景切换额外停顿 / 章节末尾额外静音
AB_PAUSE_SCALE=1.0
AB_PAUSE_MIN_MS=80
AB_PAUSE_MAX_MS=1200
AB_PAUSE_SCENE_EXTRA_MS=500
AB_PAUSE_TAIL_MS=0
# 响度：lufs（默认 -16 LUFS / 真峰值 -1.5 dBTP）| rms（有声书平台 -18~-23 dB）| off（草稿，不调 ffmpeg）
AB_LOUDNESS_MODE=lufs
AB_LOUDNESS_TARGET_LUFS=-16
AB_LOUDNESS_TRUE_PEAK=-1.5
AB_LOUDNESS_RMS_TARGET_DB=-20

# 合成引擎：fake（无 GPU 验证）/ http（连独立 TTS 服务）
AB_ENGINE=fake
AB_TTS_ENDPOINTS=["http://127.0.0.1:8020"]
AB_SYNTH_CONCURRENCY_MAX=16
AB_TTS_BREAKER_SECONDS=60

# 一键启动本机 TTS 服务（设置页那个按钮 / aiab tts start）的默认值
# 后端：fake（无 GPU 验证）| indextts（IndexTTS-2.5 真合成）
AB_TTS_BACKEND=fake
# 模型来源：local（本地已有权重，不下载）| modelscope | huggingface
AB_TTS_MODEL_SOURCE=local
# 模型目录，相对 tts/；local 时指向已有的 IndexTTS-2.5 权重目录
AB_TTS_MODEL_DIR=checkpoints
# 走 HuggingFace 镜像时填，例如 https://hf-mirror.com
AB_TTS_HF_ENDPOINT=
AB_TTS_PORT=8020
