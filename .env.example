# 后端（AB_ 前缀的环境变量会被 Settings 读取；复制为 .env 后修改）
AB_DATA_DIR=data

# LLM：任意 OpenAI 兼容端点（本机网关 / vLLM / one-api / Ollama）
AB_LLM_BASE_URL=http://127.0.0.1:8009/v1
AB_LLM_API_KEY=sk-local
AB_LLM_MODEL=deepseek-flash
AB_LLM_TEMPERATURE=0.6
AB_LLM_CONCURRENCY=8
AB_LLM_TIMEOUT_SECONDS=120
AB_LLM_MAX_ATTEMPTS=2
AB_LLM_JSON_MODE=true

# 分析分块上限（字符数）
AB_LLM_CHUNK_CHARS=8000
AB_LLM_SCENE_WINDOW_CHARS=8000
